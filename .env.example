# ---------------------------------------------------------------------------
# Techomato Labs API configuration.
# Copy to `.env` (cp .env.example .env) and edit. Docker Compose reads this file
# for both variable substitution and the containers' environment.
# Do not wrap values in quotes and avoid `$` characters.
# ---------------------------------------------------------------------------

# ---- Django -----------------------------------------------------------------
DJANGO_DEBUG=true
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO

# ---- Frontend / CORS / cookies ---------------------------------------------
# Where the SPA runs. Used for CORS, CSRF and for links inside emails.
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# In production (HTTPS) set both *_SECURE=true. If the SPA and API live on
# different registrable domains also set both *_SAMESITE=None.
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax
SESSION_COOKIE_AGE=1209600
# Behind a TLS-terminating proxy:
USE_X_FORWARDED_PROTO=false
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0
# Number of trusted reverse proxies in front of the API (for per-IP throttling).
THROTTLE_NUM_PROXIES=0

# ---- PostgreSQL -------------------------------------------------------------
POSTGRES_DB=techomato
POSTGRES_USER=techomato
POSTGRES_PASSWORD=techomato_dev_password
# Containers override the host with the compose service name (`db`); this value
# is for running manage.py directly on your machine.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DB_CONN_MAX_AGE=60

# ---- Redis (cache + sessions + Celery broker) ------------------------------
# Containers override this with redis://redis:6379.
REDIS_URL=redis://localhost:6379
REDIS_CACHE_DB=0
REDIS_SESSION_DB=1
REDIS_BROKER_DB=2
REDIS_RESULT_DB=3

# ---- Celery -----------------------------------------------------------------
CELERY_LOG_LEVEL=info
CELERY_CONCURRENCY=2
# Run tasks inline instead of through the worker (handy for debugging).
CELERY_TASK_ALWAYS_EAGER=false

# ---- Email ------------------------------------------------------------------
# `console` prints emails (verification / reset links) to the worker's log.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Techomato Labs <no-reply@techomato.dev>
# For real delivery use django.core.mail.backends.smtp.EmailBackend and set:
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
EMAIL_USE_SSL=false

# ---- Admin / moderator account ---------------------------------------------
# Created/updated on every start of the web container. Leave blank to skip.
ADMIN_EMAIL=admin@techomato.dev
ADMIN_PASSWORD=change-me-admin-password
ADMIN_NAME=Techomato Admin

# ---- OAuth (leave blank to disable a provider) -----------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- Password / token policy -----------------------------------------------
PASSWORD_MIN_LENGTH=8
PASSWORD_RESET_TIMEOUT=1800
EMAIL_VERIFICATION_MAX_AGE=259200

# ---- Rate limits (DRF format: N/sec|min|hour|day) ---------------------------
THROTTLE_ANON=300/min
THROTTLE_USER=600/min
THROTTLE_AUTH=20/min

# ---- Container / server -----------------------------------------------------
# Host ports published by docker compose
WEB_PORT=8000
DB_HOST_PORT=5432
REDIS_HOST_PORT=6379
# Build the image with pytest & friends (set false for production images)
INSTALL_DEV=true
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=30
# Auto-reload gunicorn when source changes (dev only)
GUNICORN_RELOAD=true
# Create the built-in community gallery circuits on start
SEED_GALLERY=true
