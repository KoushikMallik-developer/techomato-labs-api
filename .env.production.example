# ---------------------------------------------------------------------------
# PRODUCTION configuration for docker-compose.prod.yml.
#   cp .env.production.example .env.production   (never commit the real file)
# Every value marked CHANGE must be replaced. The container refuses to start
# (deployment checks) if secrets are placeholders/weak or origins aren't HTTPS.
# Use letters and digits only in passwords/keys where they are embedded in URLs
# (REDIS_PASSWORD). Do not wrap values in quotes and avoid `$`.
# ---------------------------------------------------------------------------

# ---- Django -----------------------------------------------------------------
DJANGO_DEBUG=false
# CHANGE: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=api.techomato.com
# Hide the Django admin behind an unguessable path (no leading/trailing slash).
DJANGO_ADMIN_URL=ops-9f3k2x
LOG_LEVEL=INFO

# ---- Domains ----------------------------------------------------------------
# Public site (used for CORS, CSRF and email links) and API host (Caddy).
FRONTEND_URL=https://techomato.com
CORS_ALLOWED_ORIGINS=https://techomato.com
CSRF_TRUSTED_ORIGINS=https://techomato.com
API_DOMAIN=api.techomato.com
ACME_EMAIL=support@techomato.com

# ---- Cookies / TLS ----------------------------------------------------------
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
# Site and API on the same registrable domain (techomato.com / api.techomato.com):
# Lax works. If they are on different domains use None (requires Secure).
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax
SESSION_COOKIE_AGE=1209600
USE_X_FORWARDED_PROTO=true
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
# Number of reverse proxies in front of the API (Caddy = 1).
THROTTLE_NUM_PROXIES=1

# ---- PostgreSQL -------------------------------------------------------------
POSTGRES_DB=techomato
POSTGRES_USER=techomato
# CHANGE: 20+ random characters
POSTGRES_PASSWORD=
DB_CONN_MAX_AGE=60

# ---- Redis ------------------------------------------------------------------
# CHANGE: 20+ random letters/digits
REDIS_PASSWORD=
REDIS_CACHE_DB=0
REDIS_SESSION_DB=1
REDIS_BROKER_DB=2
REDIS_RESULT_DB=3

# ---- Celery -----------------------------------------------------------------
CELERY_LOG_LEVEL=info
CELERY_CONCURRENCY=2

# ---- Email (Brevo shown; any SMTP provider works) ---------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=Techomato Labs <no-reply@techomato.com>

# ---- Admin / moderator account ---------------------------------------------
ADMIN_EMAIL=
# CHANGE: 16+ random characters
ADMIN_PASSWORD=
ADMIN_NAME=Techomato Admin

# ---- OAuth (redirect URIs must be registered for https://techomato.com/oauth/callback/<provider>) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- Policy / limits --------------------------------------------------------
PASSWORD_MIN_LENGTH=8
PASSWORD_RESET_TIMEOUT=1800
EMAIL_VERIFICATION_MAX_AGE=259200
THROTTLE_ANON=300/min
THROTTLE_USER=600/min
THROTTLE_AUTH=20/min

# ---- Container / server -----------------------------------------------------
WEB_BIND=127.0.0.1
WEB_PORT=8000
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=30
SEED_GALLERY=true
